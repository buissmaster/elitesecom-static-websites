{
  "trailingSlash": false,

  "routes": [
    {
      "src": "^/(?:unicommerce-alternative|easyecom-alternative|vinculum-alternative|browntape-alternative|anchanto-alternative|shiprocket-alternative|increff-alternative|evanik-alternative|omsguru-alternative|zoho-inventory-alternative|odoo-alternative|netsuite-alternative)(?:/index\\.html)?/?$",
      "status": 410
    }
  ],

  "rewrites": [
    { "source": "/ourservices", "destination": "/ourservices/index.html" },
    { "source": "/integration", "destination": "/integration/index.html" },
    { "source": "/customer", "destination": "/customer/index.html" },
    { "source": "/aboutus", "destination": "/aboutus/index.html" },
    { "source": "/faqs", "destination": "/faqs/index.html" },
    { "source": "/Blog", "destination": "/Blog/index.html" },
    { "source": "/Blog/:slug", "destination": "/Blog/:slug/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/contactus", "destination": "/contactus/index.html" },
    { "source": "/requestdemo", "destination": "/requestdemo/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/team", "destination": "/team/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
